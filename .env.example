HTTP_ADDR=:8080
# Frontend origin for cookie auth (credentials: include), e.g. http://localhost:5173
# CORS_ALLOW_ORIGIN=http://localhost:5173

IRBIS_HOST=127.0.0.1
IRBIS_PORT=6666
# Default ARM: C=Cataloger. Per-request: header X-Irbis-Workstation (A|C|M|R|B|K).
IRBIS_WORKSTATION=C
IRBIS_DEFAULT_DATABASE=IBIS
IRBIS_DIAL_TIMEOUT=10s
IRBIS_IO_TIMEOUT=0s
IRBIS_USE_REQUEST_CREDENTIALS=true
# IRBIS_SERVICE_USERNAME=
# IRBIS_SERVICE_PASSWORD=
# IRBIS_DATABASES_MENU=1..dbnam2.mnu

AUTH_ALLOW_PLAINTEXT=true
# Users: user||user… each user = name|password_or_$2hash|DB=read,write&DB2=read
AUTH_USERS=librarian|secret|IBIS=read,write&RDR=read||reader|reader|IBIS=read
# Or a plain text file (one user per line, same format):
# AUTH_USERS_FILE=users.txt
