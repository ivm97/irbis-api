HTTP_ADDR=:8080
# Frontend origin for cookie auth (credentials: include)
CORS_ALLOW_ORIGIN=http://localhost:5173

IRBIS_ADDR=127.0.0.1:6666
# Default ARM: C=Cataloger. Per-request: header X-Irbis-Workstation (A|C|M|R|B|K).
IRBIS_WORKSTATION=C
IRBIS_DEFAULT_DATABASE=IBIS
IRBIS_DIAL_TIMEOUT=10s
IRBIS_IO_TIMEOUT=0s
IRBIS_USE_REQUEST_CREDENTIALS=true

# Admin account: GetUserList + read user ini/mnu (ACL). Not used for user catalog ops when
# IRBIS_USE_REQUEST_CREDENTIALS=true.
IRBIS_SERVICE_USERNAME=admin
IRBIS_SERVICE_PASSWORD=secret
# Fallback DB list when user has no DBNNAMECAT / personal mnu
IRBIS_DATABASES_MENU=1..dbnam2.mnu
# IRBIS file path codes: 0 = install root (user *.INI), 1 = DATAI (db_*.mnu)
IRBIS_INI_PATH=0
IRBIS_MENU_PATH=1
# Optional: try this name when DBNNAMECAT is empty (still falls back to DATABASES_MENU if empty)
# IRBIS_USER_DB_MENU_PATTERN=db_{user}.mnu
IRBIS_ACL_CACHE_TTL=5m

# RTF print templates (shabl, dopshab, …)
TEMPLATES_DIR=templates

# Optional local users (skips IRBIS ACL entirely — no ARM/mnu limits).
# Empty ACL / * / two fields = unrestricted.
AUTH_ALLOW_PLAINTEXT=true
# AUTH_USERS=librarian|secret|IBIS=read,write&RDR=read||admin|secret|*
# AUTH_USERS_FILE=users.txt
