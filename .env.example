# Optional overrides (existing process env wins over this file).
# Copy to .env next to the working directory when starting the server.

HTTP_ADDR=:8080

IRBIS_HOST=127.0.0.1
IRBIS_PORT=6666
# Default ARM: C=Cataloger. Per-request override: header X-Irbis-Workstation (A|C|M|R|B|K).
IRBIS_WORKSTATION=C
IRBIS_DEFAULT_DATABASE=IBIS
IRBIS_DIAL_TIMEOUT=10s
IRBIS_IO_TIMEOUT=0s
IRBIS_USE_REQUEST_CREDENTIALS=true
# IRBIS_SERVICE_USERNAME=
# IRBIS_SERVICE_PASSWORD=
# IRBIS_DATABASES_MENU=1..dbnam2.mnu

# AUTH_USERS_FILE=configs/users.yaml
# AUTH_ALLOW_PLAINTEXT=true
